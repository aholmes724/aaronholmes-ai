---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Aaron Holmes | Automation, Software & AI"
  description="Projects and writing about automation, software systems, AI, and continuous learning."
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="site-name" href="/">Aaron Holmes</a>

      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#learning">Learning</a>
        <a href="#about">About</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero container">
      <p class="eyebrow">Automation · Software · Systems</p>

      <h1>I build practical systems that make complicated work easier.</h1>

      <p class="intro">
        I work at the intersection of business process automation, software,
        and applied AI. This site documents what I build, what I learn, and
        the problems I am working through.
      </p>

      <div class="hero-links">
        <a class="primary-link" href="#work">View my work</a>
        <a href="#learning">Explore the learning project</a>
      </div>
    </section>

    <section id="work" class="section container">
      <p class="section-label">Selected work</p>

      <h2>Systems over shortcuts.</h2>

      <p>
        I am interested in automation architecture, CRM systems, APIs,
        technical debt, and using AI where it produces measurable value.
      </p>
    </section>

    <section id="learning" class="section container">
      <p class="section-label">Learning</p>

      <h2>Building a better alternative to doom scrolling.</h2>

      <p>
        I am developing a mobile-first learning application for short,
        useful practice sessions in software, automation, cloud computing,
        and AI.
      </p>
    </section>

    <section id="about" class="section container">
      <p class="section-label">About</p>

      <h2>Learning in public and building for real problems.</h2>

      <p>
        This site is both a professional portfolio and a working software
        project. I use it to document decisions, test ideas, and improve the
        tools I use every day.
      </p>
    </section>
  </main>
</Layout>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-name {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1rem;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .hero {
    padding-block: 6rem 5rem;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: var(--reading-width);
    margin: 2rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .primary-link {
    font-weight: 700;
  }

  .section {
    max-width: var(--reading-width);
    margin-inline: auto;
    padding-block: 4rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .section p:last-child {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  @media (max-width: 600px) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 1rem;
    }

    .hero {
      padding-block: 4rem;
    }
  }
</style>