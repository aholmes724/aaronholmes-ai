---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Learn | Aaron Holmes">
    <main class="container learn-shell">
        <div class="practice-links"><a href="/import">Import curriculum</a><a href="/practice">Practice</a><a href="/progress">Progress</a></div>
        <h1>Learn</h1>
        <section id="learn-intro" class="progress-summary"><p>Loading your saved curriculum…</p></section>
        <section id="prototype-host" class="prototype-host" hidden></section>
        <section id="readiness-summary" class="readiness-summary" hidden></section>
        <label id="topic-picker-label" class="topic-picker-label" hidden>Source section<select id="topic-picker"></select></label>
        <div id="lesson-host" class="curriculum-lessons"></div>
    </main>
</Layout>

<script>
    import { readImportedCurriculum } from "../../data/curriculum/storage";
    import { buildLearnSections, type LearnSection, type InstructionalReadiness } from "../../data/curriculum/learn-content";
    import { generateLesson, isLessonGenerationConfigured, type GeneratedLesson, type LessonKeyTerm } from "../../data/curriculum/lesson-generation-client";

    type Initialism = { term: string; expansion?: string; definition?: string };
    const intro = document.querySelector<HTMLElement>("#learn-intro"); const readinessSummary = document.querySelector<HTMLElement>("#readiness-summary");
    const prototypeHost = document.querySelector<HTMLElement>("#prototype-host"); const pickerLabel = document.querySelector<HTMLElement>("#topic-picker-label");
    const picker = document.querySelector<HTMLSelectElement>("#topic-picker"); const host = document.querySelector<HTMLElement>("#lesson-host");
    const stored = readImportedCurriculum(); let activeSentence: HTMLElement | null = null; let activeButton: HTMLButtonElement | null = null;

    const cleanText = (value: string) => value.replace(/^\s*[-*+]\s+/gm, "").replace(/^\s*\d+[.)]\s+/gm, "").replace(/^\s*\|/gm, "").replace(/\|\s*$/gm, "").replace(/\s*\|\s*/g, ". ").replace(/`([^`]+)`/g, "$1").replace(/\*\*([^*]+)\*\*/g, "$1").replace(/__([^_]+)__/g, "$1").replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/^\s*[-:| ]{3,}\s*$/gm, "").replace(/\n{3,}/g, "\n\n").trim();
    const extractInitialisms = (text: string): Initialism[] => { const found = new Map<string, Initialism>(); const patterns = [/\b([A-Z][A-Za-z]*(?:[ -][A-Z][A-Za-z]*){1,8})\s*\(([A-Z][A-Z0-9-]{1,9})\)/g,/\b([A-Z][A-Z0-9-]{1,9})\s*\(([A-Z][A-Za-z]*(?:[ -][A-Za-z]+){1,8})\)/g]; for (const pattern of patterns) for (const match of text.matchAll(pattern)) { const first = /^[A-Z0-9-]{2,10}$/.test(match[1]); const term = first ? match[1] : match[2]; found.set(term,{term,expansion:first?match[2]:match[1]}); } for (const match of text.matchAll(/\b[A-Z][A-Z0-9-]{1,9}\b/g)) if (!found.has(match[0])) found.set(match[0],{term:match[0]}); return [...found.values()]; };
    const mergeTerms = (base: Initialism[], lessonTerms: LessonKeyTerm[] = []) => { const map = new Map(base.map(term=>[term.term,term])); lessonTerms.forEach(term=>map.set(term.term,{term:term.term,expansion:term.expansion||undefined,definition:term.definition})); return [...map.values()]; };
    const appendInitialisms = (parent: HTMLElement,text:string,terms:Initialism[]) => { const usable=terms.filter(term=>text.includes(term.term)).sort((a,b)=>b.term.length-a.term.length); if(!usable.length){parent.textContent=text;return;} const escaped=usable.map(term=>term.term.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")); const pattern=new RegExp(`\\b(${escaped.join("|")})\\b`,"g"); const lookup=new Map(usable.map(term=>[term.term,term])); let cursor=0; for(const match of text.matchAll(pattern)){const index=match.index??0;if(index>cursor)parent.append(document.createTextNode(text.slice(cursor,index)));const term=lookup.get(match[0]);const abbr=document.createElement("abbr");abbr.className="initialism-help learn-initialism";abbr.tabIndex=0;abbr.textContent=match[0];const pieces=[term?.expansion,term?.definition].filter(Boolean);const tooltip=pieces.length?`${match[0]} — ${pieces.join(" · ")}`:`${match[0]} — initialism`;abbr.title=tooltip;abbr.dataset.tooltip=tooltip;abbr.setAttribute("aria-label",tooltip);parent.append(abbr);cursor=index+match[0].length;}if(cursor<text.length)parent.append(document.createTextNode(text.slice(cursor))); };
    const speechText=(text:string,terms:Initialism[])=>{let output=text;terms.forEach(term=>{const spoken=/^[A-Z0-9-]{2,8}$/.test(term.term)?term.term.replace(/-/g," ").split("").join(" "):term.term;output=output.replace(new RegExp(`\\b${term.term.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")}\\b`,"g"),spoken);});return output;};
    const stopSpeech=()=>{window.speechSynthesis?.cancel();activeSentence?.classList.remove("is-reading");if(activeButton)activeButton.textContent="Listen";activeSentence=null;activeButton=null;};
    const speakNodes=(button:HTMLButtonElement,nodes:HTMLElement[],terms:Initialism[])=>{if(!("speechSynthesis" in window)){button.disabled=true;button.textContent="Audio unavailable";return;}if(activeButton===button){stopSpeech();return;}stopSpeech();activeButton=button;button.textContent="Stop";let index=0;const next=()=>{activeSentence?.classList.remove("is-reading");if(index>=nodes.length){stopSpeech();return;}const node=nodes[index++];activeSentence=node;node.classList.add("is-reading");const utterance=new SpeechSynthesisUtterance(speechText(node.textContent??"",terms));utterance.rate=.95;utterance.onend=next;utterance.onerror=stopSpeech;window.speechSynthesis.speak(utterance);};next();};
    const readinessLabels:Record<InstructionalReadiness,string>={preserve:"Preserve",augment:"Lightly augment",transform:"Transform into lesson",insufficient:"Needs more source material"};

    const slugify=(value:string)=>value.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").slice(0,70)||"lesson";
    const lessonMarkdown=(lesson:GeneratedLesson,sourceSection:LearnSection,curriculumTitle:string)=>{const lines=[`# ${lesson.title}`,"",`**Curriculum:** ${curriculumTitle}`,"",`**Learning goal:** ${lesson.learningGoal}`,"","## Key idea","",lesson.keyIdea,""];lesson.blocks.forEach(block=>lines.push(`## ${block.heading}`,"",block.body,""));lines.push("## Distinctions that matter","",...lesson.distinctions.map(item=>`- ${item}`),"");if(lesson.keyTerms.length){lines.push("## Key terms","");lesson.keyTerms.forEach(term=>lines.push(`- **${term.term}${term.expansion?` — ${term.expansion}`:""}:** ${term.definition}`));lines.push("");}lines.push("## Remember","",lesson.memoryHook,"","## Quick check","",lesson.quickCheck.prompt,"");lesson.quickCheck.options.forEach(option=>lines.push(`- ${option.text}${option.correct?" *(correct)*":""} — ${option.feedback}`));lines.push("","## Source evidence","",cleanText(sourceSection.sourceText));if(lesson.sourceNote)lines.push("",`*${lesson.sourceNote}*`);return lines.join("\n");};
    const downloadText=(filename:string,text:string,type="text/markdown")=>{const blob=new Blob([text],{type:`${type};charset=utf-8`});const url=URL.createObjectURL(blob);const anchor=document.createElement("a");anchor.href=url;anchor.download=filename;document.body.append(anchor);anchor.click();anchor.remove();setTimeout(()=>URL.revokeObjectURL(url),0);};

    const renderRawSection=(section:LearnSection,terms:Initialism[])=>{host?.replaceChildren();if(!host||!section.decision)return;const article=document.createElement("article");article.className="curriculum-lesson";const heading=document.createElement("h2");appendInitialisms(heading,section.title,terms);const badge=document.createElement("span");badge.className=`readiness-badge readiness-${section.decision.readiness}`;badge.textContent=readinessLabels[section.decision.readiness];const why=document.createElement("details");why.className="readiness-detail";const whySummary=document.createElement("summary");whySummary.textContent="Why this classification?";const reason=document.createElement("p");reason.textContent=section.decision.reason;const signals=document.createElement("p");signals.textContent=`${section.decision.signals.join(" · ")} · confidence: ${section.decision.confidence}`;why.append(whySummary,reason,signals);const source=document.createElement("details");source.className="source-detail";const sourceSummary=document.createElement("summary");sourceSummary.textContent="View source section";const sourceBody=document.createElement("p");sourceBody.textContent=cleanText(section.sourceText);source.append(sourceSummary,sourceBody);article.append(heading,badge,why,source);host.append(article);};

    const renderGeneratedLesson=(lesson:GeneratedLesson,sourceSection:LearnSection,baseTerms:Initialism[])=>{if(!prototypeHost)return;const terms=mergeTerms(baseTerms,lesson.keyTerms);prototypeHost.replaceChildren();prototypeHost.hidden=false;const article=document.createElement("article");article.className="generated-lesson";const eyebrow=document.createElement("p");eyebrow.className="lesson-eyebrow";eyebrow.textContent="Prototype transformed lesson";const header=document.createElement("div");header.className="generated-heading";const titleWrap=document.createElement("div");const title=document.createElement("h2");appendInitialisms(title,lesson.title,terms);const goal=document.createElement("p");goal.className="learning-goal";goal.textContent=lesson.learningGoal;titleWrap.append(title,goal);const controls=document.createElement("div");controls.className="lesson-controls";const listen=document.createElement("button");listen.className="secondary-button";listen.textContent="Listen";listen.type="button";const exportButton=document.createElement("button");exportButton.className="secondary-button";exportButton.textContent="Export lesson";exportButton.type="button";exportButton.title="Download this lesson as Markdown";controls.append(listen,exportButton);header.append(titleWrap,controls);article.append(eyebrow,header);const spokenNodes:HTMLElement[]=[];
        const keyIdea=document.createElement("section");keyIdea.className="lesson-key-idea";const keyIdeaTitle=document.createElement("h3");keyIdeaTitle.textContent="Key idea";const keyIdeaBody=document.createElement("p");appendInitialisms(keyIdeaBody,lesson.keyIdea,terms);spokenNodes.push(keyIdeaBody);keyIdea.append(keyIdeaTitle,keyIdeaBody);article.append(keyIdea);
        lesson.blocks.forEach(block=>{const section=document.createElement("section");section.className="lesson-block";const heading=document.createElement("h3");appendInitialisms(heading,block.heading,terms);const body=document.createElement("p");appendInitialisms(body,block.body,terms);spokenNodes.push(body);section.append(heading,body);article.append(section);});
        const distinctions=document.createElement("section");distinctions.className="lesson-block";const distinctionsHeading=document.createElement("h3");distinctionsHeading.textContent="Distinctions that matter";distinctions.append(distinctionsHeading);const list=document.createElement("ul");lesson.distinctions.forEach(item=>{const li=document.createElement("li");appendInitialisms(li,item,terms);list.append(li);spokenNodes.push(li);});distinctions.append(list);article.append(distinctions);
        if(lesson.keyTerms.length){const termsSection=document.createElement("section");termsSection.className="lesson-block";const termsHeading=document.createElement("h3");termsHeading.textContent="Key terms";termsSection.append(termsHeading);const chips=document.createElement("div");chips.className="term-chips";lesson.keyTerms.forEach(term=>{const chip=document.createElement("abbr");chip.className="initialism-help learn-initialism term-chip";chip.tabIndex=0;chip.textContent=term.term;const tooltip=`${term.term} — ${[term.expansion,term.definition].filter(Boolean).join(" · ")}`;chip.title=tooltip;chip.dataset.tooltip=tooltip;chip.setAttribute("aria-label",tooltip);chips.append(chip);});termsSection.append(chips);article.append(termsSection);}
        const remember=document.createElement("section");remember.className="memory-hook";const rememberLabel=document.createElement("strong");rememberLabel.textContent="Remember: ";remember.append(rememberLabel,document.createTextNode(lesson.memoryHook));article.append(remember);const check=document.createElement("section");check.className="quick-check";const checkTitle=document.createElement("h3");checkTitle.textContent="Quick check";const checkPrompt=document.createElement("p");checkPrompt.textContent=lesson.quickCheck.prompt;check.append(checkTitle,checkPrompt);lesson.quickCheck.options.forEach(option=>{const button=document.createElement("button");button.type="button";button.className="quick-check-option";button.textContent=option.text;button.addEventListener("click",()=>{check.querySelectorAll(".quick-check-feedback").forEach(node=>node.remove());const feedback=document.createElement("p");feedback.className="quick-check-feedback";feedback.textContent=`${option.correct?"Correct. ":"Not quite. "}${option.feedback}`;check.append(feedback);});check.append(button);});const note=document.createElement("small");note.textContent="Reinforcement only — this does not count toward mastery.";check.append(note);article.append(check);
        const evidence=document.createElement("details");evidence.className="source-detail";const evidenceTitle=document.createElement("summary");evidenceTitle.textContent="View source evidence";const evidenceBody=document.createElement("p");evidenceBody.textContent=cleanText(sourceSection.sourceText);evidence.append(evidenceTitle,evidenceBody);article.append(evidence);if(lesson.sourceNote){const sourceNote=document.createElement("p");sourceNote.className="source-note";sourceNote.textContent=lesson.sourceNote;article.append(sourceNote);}listen.addEventListener("click",()=>speakNodes(listen,spokenNodes,terms));exportButton.addEventListener("click",()=>downloadText(`${slugify(lesson.title)}.md`,lessonMarkdown(lesson,sourceSection,stored?.curriculum.title??"Curriculum")));prototypeHost.append(article);};

    window.addEventListener("beforeunload",stopSpeech);
    if(!stored||!intro||!host||!picker||!pickerLabel){if(intro)intro.innerHTML=`<h2>No curriculum saved</h2><p>Import source material first, then it will become your Learn content.</p><p><a class="new-session-button" href="/import">Import curriculum</a></p>`;}else{const sourceText=stored.sourceText?.trim()??"";const sections=buildLearnSections(stored.curriculum,sourceText||stored.curriculum.concepts.map(concept=>`## ${concept.label}\n${concept.description??""}`).join("\n\n"));const learnerSections=sections.filter(section=>section.role.role==="learner-content");const objectives=sections.filter(section=>section.role.role==="objectives");const metadata=sections.filter(section=>section.role.role==="metadata");const evidenceText=stored.curriculum.questionDrafts.map(draft=>draft.sourceEvidence?.excerpt??"").join("\n");const baseTerms=extractInitialisms(`${sourceText}\n${evidenceText}`);intro.replaceChildren();const title=document.createElement("h2");title.textContent=stored.curriculum.title;const summary=document.createElement("p");summary.textContent=`${learnerSections.length} learner-facing source section${learnerSections.length===1?"":"s"}. ${metadata.length+objectives.length} non-lesson section${metadata.length+objectives.length===1?"":"s"} are now kept out of Learn.`;intro.append(title,summary);if(!sourceText){const warning=document.createElement("p");warning.className="learn-source-note";warning.textContent="This saved curriculum lacks the original full source text. Re-importing it will improve lesson generation.";intro.append(warning);}if(readinessSummary){const counts=learnerSections.reduce<Record<InstructionalReadiness,number>>((acc,section)=>{if(section.decision)acc[section.decision.readiness]+=1;return acc;},{preserve:0,augment:0,transform:0,insufficient:0});readinessSummary.hidden=false;readinessSummary.innerHTML=`<strong>Source decisions</strong><span>${counts.preserve} preserve</span><span>${counts.augment} augment</span><span>${counts.transform} transform</span><span>${counts.insufficient} insufficient</span><span>${metadata.length} metadata excluded</span><span>${objectives.length} objectives kept as context</span>`;}pickerLabel.hidden=learnerSections.length===0;learnerSections.forEach((section,index)=>{const option=document.createElement("option");option.value=section.id;option.textContent=`${index+1}. ${section.title}`;picker.append(option);});const showSelected=()=>{const section=learnerSections.find(item=>item.id===picker.value)??learnerSections[0];if(section)renderRawSection(section,baseTerms);};picker.addEventListener("change",showSelected);showSelected();const prototypeSource=learnerSections.find(section=>section.decision?.readiness==="transform");if(prototypeSource&&prototypeHost){prototypeHost.hidden=false;const card=document.createElement("article");card.className="prototype-callout";const heading=document.createElement("h2");heading.textContent="First transformed lesson";const copy=document.createElement("p");copy.textContent=`Use “${prototypeSource.title}” to test the teaching transformation before generating lessons for the rest of the curriculum.`;const button=document.createElement("button");button.type="button";button.className="new-session-button";button.textContent="Generate prototype lesson";const status=document.createElement("p");status.className="prototype-status";card.append(heading,copy,button,status);prototypeHost.append(card);const cacheKey=`aaronholmes.lesson-prototype.${stored.curriculum.id}.${prototypeSource.id}`;const cached=sessionStorage.getItem(cacheKey);if(cached){try{renderGeneratedLesson(JSON.parse(cached),prototypeSource,baseTerms);}catch{sessionStorage.removeItem(cacheKey);}}button.addEventListener("click",async()=>{if(!isLessonGenerationConfigured()){status.textContent="Lesson generation is not configured.";return;}button.disabled=true;button.textContent="Generating…";status.textContent="Building one source-grounded lesson…";try{const lesson=await generateLesson({curriculumTitle:stored.curriculum.title,sectionTitle:prototypeSource.title,sourceText:prototypeSource.sourceText,objectivesText:objectives.map(section=>`${section.title}\n${section.sourceText}`).join("\n\n"),neighboringContext:learnerSections.filter(section=>section.id!==prototypeSource.id).slice(0,2).map(section=>`${section.title}\n${section.sourceText}`).join("\n\n")});sessionStorage.setItem(cacheKey,JSON.stringify(lesson));renderGeneratedLesson(lesson,prototypeSource,baseTerms);}catch(error){status.textContent=error instanceof Error?error.message:"Lesson generation failed.";button.disabled=false;button.textContent="Try again";}});}}
</script>

<style>
.learn-shell{padding-bottom:4rem}.readiness-summary{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin:1rem 0;padding:.8rem 1rem;border:1px solid var(--border);border-radius:.75rem;background:var(--surface)}.readiness-summary span{padding:.25rem .5rem;border-radius:999px;background:var(--surface-alt);font-size:.86rem}.topic-picker-label{display:grid;gap:.35rem;max-width:38rem;margin:1rem 0;font-weight:650}.topic-picker-label select{width:100%;padding:.65rem;border:1px solid var(--border);border-radius:.55rem;background:var(--surface);color:inherit}.prototype-host,.curriculum-lessons{max-width:var(--reading-width);margin:1rem 0}.prototype-callout,.generated-lesson,.curriculum-lesson{padding:1.15rem;border:1px solid var(--border);border-radius:.8rem;background:var(--surface)}.prototype-callout h2,.generated-lesson h2,.curriculum-lesson h2{margin-top:0}.lesson-eyebrow{margin:0 0 .4rem;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.generated-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.lesson-controls{display:flex;gap:.5rem;flex:0 0 auto}.learning-goal{color:var(--muted);margin-top:.35rem}.lesson-key-idea,.lesson-block,.memory-hook,.quick-check{margin-top:1.2rem}.lesson-key-idea{padding:.85rem;background:var(--surface-alt);border-radius:.65rem}.lesson-block h3,.lesson-key-idea h3,.quick-check h3{margin:0 0 .45rem;font-size:1rem}.lesson-block p,.lesson-key-idea p{line-height:1.7}.term-chips{display:flex;flex-wrap:wrap;gap:.5rem}.term-chip{display:inline-block;padding:.35rem .55rem!important}.memory-hook{padding:.75rem;border-left:3px solid var(--accent);background:var(--surface-alt)}.quick-check{padding-top:1rem;border-top:1px solid var(--border)}.quick-check-option{display:block;width:100%;text-align:left;margin:.5rem 0;padding:.7rem;border:1px solid var(--border);border-radius:.55rem;background:var(--surface-alt);color:inherit;cursor:pointer}.quick-check-feedback{font-weight:650}.source-detail,.readiness-detail{margin-top:.9rem;color:var(--muted)}.source-detail summary,.readiness-detail summary{cursor:pointer}.source-detail p{white-space:pre-wrap;line-height:1.6}.source-note,.prototype-status{color:var(--muted);font-size:.9rem}.readiness-badge{display:inline-block;padding:.2rem .48rem;border:1px solid var(--border);border-radius:999px;font-size:.75rem;font-weight:650}.readiness-preserve{background:color-mix(in srgb,#35a854 14%,transparent)}.readiness-augment{background:color-mix(in srgb,#4b8ed8 14%,transparent)}.readiness-transform{background:color-mix(in srgb,#d39a31 16%,transparent)}.readiness-insufficient{background:color-mix(in srgb,#c94d4d 14%,transparent)}.read-along-sentence.is-reading{background:var(--surface-alt)}.learn-source-note{padding:.75rem;border-left:3px solid var(--accent);background:var(--surface-alt)}:global(.learn-initialism){padding:0 .12em;border-radius:.22rem;background:color-mix(in srgb,var(--accent) 14%,transparent);font-weight:650;text-decoration:underline dotted;text-underline-offset:.2em}:global(.learn-initialism:hover),:global(.learn-initialism:focus){background:color-mix(in srgb,var(--accent) 24%,transparent)}@media(max-width:600px){.generated-heading{display:grid}.lesson-controls{flex-wrap:wrap}}
</style>