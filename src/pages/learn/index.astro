---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Learn | Aaron Holmes">
  <main class="container learn-home-shell">
    <div class="practice-links">
      <a href="/import">New curriculum</a>
      <a href="/practice">Practice</a>
      <a href="/progress">Progress</a>
    </div>

    <h1>Learn</h1>
    <section id="learn-home" class="progress-summary">
      <p>Loading your saved curriculum…</p>
    </section>
  </main>
</Layout>

<script>
  import { readImportedCurriculum } from "../../data/curriculum/storage";
  import { buildLearnSections } from "../../data/curriculum/learn-content";
  import { buildLessonGroups } from "../../data/curriculum/lesson-groups";

  const host = document.querySelector<HTMLElement>("#learn-home");
  const stored = readImportedCurriculum();

  if (host) {
    if (!stored) {
      const heading = document.createElement("h2");
      heading.textContent = "Start with a curriculum";
      const body = document.createElement("p");
      body.textContent = "Import source material to build a learning sequence and practice set.";
      const action = document.createElement("a");
      action.className = "new-session-button";
      action.href = "/import";
      action.textContent = "Import curriculum";
      host.replaceChildren(heading, body, action);
    } else {
      const sourceText = stored.sourceText?.trim()
        || stored.curriculum.concepts
          .map((concept) => `## ${concept.label}\n${concept.description ?? ""}`)
          .join("\n\n");
      const sections = buildLearnSections(stored.curriculum, sourceText);
      const groups = buildLessonGroups(sections);
      const learnerSections = sections.filter((section) => section.role.role === "learner-content");

      const heading = document.createElement("h2");
      heading.textContent = stored.curriculum.title;
      const body = document.createElement("p");
      body.textContent = `${groups.length} lesson${groups.length === 1 ? "" : "s"} built from ${learnerSections.length} learner-facing source section${learnerSections.length === 1 ? "" : "s"}.`;

      const actions = document.createElement("div");
      actions.className = "learn-home-actions";
      const continueLink = document.createElement("a");
      continueLink.className = "new-session-button";
      continueLink.href = "/learn/sequence";
      continueLink.textContent = "Continue learning";
      const practiceLink = document.createElement("a");
      practiceLink.className = "secondary-button";
      practiceLink.href = "/practice/imported";
      practiceLink.textContent = "Practice curriculum";
      actions.append(continueLink, practiceLink);

      const note = document.createElement("p");
      note.className = "learn-home-note";
      note.textContent = stored.sourceText?.trim()
        ? "Your source material is saved with this curriculum."
        : "This saved curriculum predates source-text persistence. Re-importing the original source can improve future lesson generation.";

      const diagnostics = document.createElement("details");
      diagnostics.className = "learn-home-diagnostics";
      const summary = document.createElement("summary");
      summary.textContent = "Developer / source diagnostics";
      const diagnosticsBody = document.createElement("p");
      diagnosticsBody.textContent = "Inspect source classifications and transformation readiness without cluttering the learner view.";
      const diagnosticsLink = document.createElement("a");
      diagnosticsLink.href = "/learn/diagnostics";
      diagnosticsLink.textContent = "Open diagnostics";
      diagnostics.append(summary, diagnosticsBody, diagnosticsLink);

      host.replaceChildren(heading, body, actions, note, diagnostics);
    }
  }
</script>

<style>
  .learn-home-shell{padding-bottom:4rem}.learn-home-shell .progress-summary{max-width:var(--reading-width);padding:1.25rem}.learn-home-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.2rem 0}.learn-home-note{color:var(--text-muted)}.learn-home-diagnostics{margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--border)}.learn-home-diagnostics summary{cursor:pointer;font-weight:650}.learn-home-diagnostics p{color:var(--text-muted)}@media(max-width:620px){.learn-home-actions a{width:100%;text-align:center}}
</style>
