---
import Layout from '../../layouts/Layout.astro';
import QuizQuestion from '../../components/QuizQuestion.astro';
---

<Layout title="Automation Basics | Aaron Holmes">
	<main class="container">
		<p>AUTOMATION BASICS</p>

		<h1>What is automation?</h1>

		<p>
			Automation is the use of technology to perform a process with reduced
			human intervention.
		</p>
        <a href="/learn">Back to Learn</a>
        <QuizQuestion
	question="Which example is automation?"
	incorrectAnswer="A person manually copying data between two systems"
	correctAnswer="A workflow automatically creating a CRM record from a form submission"
	incorrectFeedback="Not quite. A person is still performing the task manually."
	correctFeedback="Correct! The workflow performs the task automatically."
/>
		<QuizQuestion
	question="What is the main benefit of automation?"
	incorrectAnswer="It guarantees that a process can never fail"
	correctAnswer="It reduces repetitive manual work"
	incorrectFeedback="Not quite. Automated processes can still fail and need monitoring."
	correctFeedback="Correct! Reducing repetitive manual work is one of automation's primary benefits."
/>
	</main>
</Layout>
