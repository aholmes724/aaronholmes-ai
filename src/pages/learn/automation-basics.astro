---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Automation Basics | Aaron Holmes">
	<main class="container">
		<p>AUTOMATION BASICS</p>

		<h1>What is automation?</h1>

		<p>
			Automation is the use of technology to perform a process with reduced
			human intervention.
		</p>
        <a href="/learn">Back to Learn</a>
        <section>
	<h2>Quick check</h2>

	<p>Which example is automation?</p>

	<button id="manual-answer" type="button">
	A person manually copying data between two systems
</button>
	<button id="automation-answer" type="button">
	A workflow automatically creating a CRM record from a form submission
</button>
<p id="feedback" aria-live="polite"></p>
</section>
	</main>
</Layout>
<script>
	const manualAnswer =
	document.querySelector<HTMLButtonElement>('#manual-answer');

const automationAnswer =
	document.querySelector<HTMLButtonElement>('#automation-answer');
	const feedback = document.querySelector('#feedback');

	manualAnswer?.addEventListener('click', () => {
	if (feedback) {
		feedback.textContent =
			'Not quite. A person is still performing the task manually.';
	}

	if (manualAnswer && automationAnswer) {
		manualAnswer.disabled = true;
		automationAnswer.disabled = true;
	}
});

	automationAnswer?.addEventListener('click', () => {
		if (feedback) {
			feedback.textContent =
				'Correct! The workflow performs the task automatically.';
		}

        if (manualAnswer && automationAnswer) {
	        manualAnswer.disabled = true;
	        automationAnswer.disabled = true;
}
	});
</script>