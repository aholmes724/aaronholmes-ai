---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Lesson sequence | Aaron Holmes">
  <main class="container sequence-shell">
    <div class="practice-links"><a href="/learn">← Learn</a><a href="/import">New curriculum</a><a href="/practice">Practice</a></div>
    <h1>Lesson sequence</h1>
    <section id="sequence-intro" class="progress-summary"><p>Loading lesson groups…</p></section>
    <div id="sequence-actions" class="sequence-actions" hidden>
      <button id="generate-sequence" class="new-session-button" type="button">Generate first 3 lessons</button>
      <button id="export-sequence" class="secondary-button" type="button" hidden>Export generated sequence</button>
      <button id="clear-sequence" class="secondary-button" type="button">Clear generated lessons</button>
    </div>
    <section id="generation-progress" class="generation-progress" hidden aria-live="polite">
      <div class="generation-progress-heading"><strong id="generation-progress-label">Generating lessons…</strong><span id="generation-progress-count"></span></div>
      <div class="generation-progress-track" aria-hidden="true"><span id="generation-progress-bar"></span></div>
      <p id="generation-progress-detail">Please keep this tab open.</p>
    </section>
    <p id="sequence-status" class="sequence-status" aria-live="polite"></p>
    <div id="group-list" class="group-list"></div>
    <section id="queue-actions" class="queue-actions" hidden>
      <p id="queue-summary"></p>
      <div class="queue-buttons">
        <button id="previous-lesson" class="secondary-button" type="button" hidden>← Previous lesson</button>
        <button id="generate-next" class="new-session-button" type="button">Generate next lesson →</button>
        <button id="generate-next-three" class="secondary-button" type="button">Generate next 3 lessons</button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { readImportedCurriculum } from "../../data/curriculum/storage";
  import { buildLearnSections } from "../../data/curriculum/learn-content";
  import { buildLessonGroups, lessonGroupSource, type LessonGroup } from "../../data/curriculum/lesson-groups";
  import { generateLesson, isLessonGenerationConfigured, type GeneratedLesson } from "../../data/curriculum/lesson-generation-client";

  const stored = readImportedCurriculum();
  const intro = document.querySelector<HTMLElement>("#sequence-intro");
  const actions = document.querySelector<HTMLElement>("#sequence-actions");
  const generateButton = document.querySelector<HTMLButtonElement>("#generate-sequence");
  const exportSequenceButton = document.querySelector<HTMLButtonElement>("#export-sequence");
  const clearButton = document.querySelector<HTMLButtonElement>("#clear-sequence");
  const status = document.querySelector<HTMLElement>("#sequence-status");
  const list = document.querySelector<HTMLElement>("#group-list");
  const queueActions = document.querySelector<HTMLElement>("#queue-actions");
  const queueSummary = document.querySelector<HTMLElement>("#queue-summary");
  const previousButton = document.querySelector<HTMLButtonElement>("#previous-lesson");
  const nextButton = document.querySelector<HTMLButtonElement>("#generate-next");
  const nextThreeButton = document.querySelector<HTMLButtonElement>("#generate-next-three");
  const progress = document.querySelector<HTMLElement>("#generation-progress");
  const progressLabel = document.querySelector<HTMLElement>("#generation-progress-label");
  const progressCount = document.querySelector<HTMLElement>("#generation-progress-count");
  const progressBar = document.querySelector<HTMLElement>("#generation-progress-bar");
  const progressDetail = document.querySelector<HTMLElement>("#generation-progress-detail");

  const cacheKey = (curriculumId: string, groupId: string) => `aaronholmes.lesson-group.v1.${curriculumId}.${groupId}`;
  const clean = (value: string) => value.replace(/^\s*\d+[.)]\s*/, "").trim();
  const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 70) || "lesson";
  const downloadText = (filename: string, text: string) => { const blob = new Blob([text], { type: "text/markdown;charset=utf-8" }); const url = URL.createObjectURL(blob); const anchor = document.createElement("a"); anchor.href = url; anchor.download = filename; document.body.append(anchor); anchor.click(); anchor.remove(); setTimeout(() => URL.revokeObjectURL(url), 0); };

  const lessonMarkdown = (group: LessonGroup, lesson: GeneratedLesson, index: number) => {
    const lines = [`# ${lesson.title}`, "", `**Lesson ${index + 1}**`, stored ? `**Curriculum:** ${stored.curriculum.title}` : "", "", `**Learning goal:** ${lesson.learningGoal}`, "", "## Key idea", "", lesson.keyIdea, ""];
    lesson.blocks.forEach((block) => lines.push(`## ${block.heading}`, "", block.body, ""));
    lines.push("## Distinctions that matter", "", ...lesson.distinctions.map((item) => `- ${item}`), "");
    if (lesson.keyTerms.length) { lines.push("## Key terms", ""); lesson.keyTerms.forEach((term) => { lines.push(`- **${term.term}${term.expansion ? ` — ${term.expansion}` : ""}:** ${term.definition}`); if (term.whyItMatters) lines.push(`  - Why it matters: ${term.whyItMatters}`); }); lines.push(""); }
    lines.push("## Remember", "", lesson.memoryHook, "", "## Quick check", "", lesson.quickCheck.prompt, "");
    lesson.quickCheck.options.forEach((option) => lines.push(`- ${option.text}${option.correct ? " *(correct)*" : ""} — ${option.feedback}`));
    lines.push("", "## Source sections", "", ...group.sections.map((section) => `- ${clean(section.title)}`)); if (lesson.sourceNote) lines.push("", `*${lesson.sourceNote}*`); return lines.join("\n");
  };

  const getCachedLesson = (group: LessonGroup): GeneratedLesson | null => { if (!stored) return null; const raw = sessionStorage.getItem(cacheKey(stored.curriculum.id, group.id)); if (!raw) return null; try { return JSON.parse(raw) as GeneratedLesson; } catch { sessionStorage.removeItem(cacheKey(stored.curriculum.id, group.id)); return null; } };

  if (!stored || !intro || !list) {
    if (intro) intro.innerHTML = `<h2>No curriculum saved</h2><p><a href="/import">Import curriculum</a> first.</p>`;
  } else {
    const sourceText = stored.sourceText?.trim() || stored.curriculum.concepts.map((concept) => `## ${concept.label}\n${concept.description ?? ""}`).join("\n\n");
    const sections = buildLearnSections(stored.curriculum, sourceText); const groups = buildLessonGroups(sections);
    intro.innerHTML = `<h2>${stored.curriculum.title}</h2><p>${groups.length} proposed teaching units from ${sections.filter((section) => section.role.role === "learner-content").length} learner-facing source sections.</p>`; actions!.hidden = false;

    let visibleStart = 0;
    let visibleAmount = Math.min(3, groups.length);

    const generatedCount = () => { let count = 0; for (const group of groups) { if (!getCachedLesson(group)) break; count += 1; } return count; };
    const goTop = () => window.scrollTo({ top: 0, behavior: "smooth" });

    const renderLesson = (group: LessonGroup, lesson: GeneratedLesson, index: number) => {
      const article = document.createElement("article"); article.className = "sequence-card generated-sequence-card";
      const eyebrow = document.createElement("p"); eyebrow.className = "lesson-eyebrow"; eyebrow.textContent = `Lesson ${index + 1} of ${groups.length}`;
      const header = document.createElement("div"); header.className = "sequence-card-heading"; const titleWrap = document.createElement("div"); const heading = document.createElement("h2"); heading.textContent = lesson.title; const goal = document.createElement("p"); goal.className = "learning-goal"; goal.textContent = lesson.learningGoal; titleWrap.append(heading, goal);
      const exportButton = document.createElement("button"); exportButton.type = "button"; exportButton.className = "secondary-button compact-button"; exportButton.textContent = "Export lesson"; exportButton.addEventListener("click", () => downloadText(`${String(index + 1).padStart(2, "0")}-${slugify(lesson.title)}.md`, lessonMarkdown(group, lesson, index))); header.append(titleWrap, exportButton);
      const keyHeading = document.createElement("h3"); keyHeading.textContent = "Key idea"; const key = document.createElement("p"); key.textContent = lesson.keyIdea;
      const details = document.createElement("details"); const summary = document.createElement("summary"); summary.textContent = "View lesson"; details.append(summary); lesson.blocks.forEach((block) => { const h = document.createElement("h3"); h.textContent = block.heading; const p = document.createElement("p"); p.textContent = block.body; details.append(h,p); });
      const source = document.createElement("p"); source.className = "group-source-count"; source.textContent = `Built from ${group.sections.length} source section${group.sections.length === 1 ? "" : "s"}: ${group.sections.map((section) => clean(section.title)).join(" · ")}`; article.append(eyebrow,header,keyHeading,key,details,source); return article;
    };

    const redraw = () => {
      list.replaceChildren(); const count = generatedCount();
      if (count > 0) {
        const end = Math.min(visibleStart + visibleAmount, count);
        for (let index = visibleStart; index < end; index += 1) { const lesson = getCachedLesson(groups[index]); if (lesson) list.append(renderLesson(groups[index], lesson, index)); }
      }
      if (exportSequenceButton) exportSequenceButton.hidden = count === 0; if (generateButton) generateButton.hidden = count > 0;
      if (queueActions && queueSummary) {
        const remaining = groups.length - count; queueActions.hidden = count === 0;
        const visibleEnd = Math.min(visibleStart + visibleAmount, count);
        queueSummary.textContent = remaining > 0 ? `Showing lessons ${visibleStart + 1}–${visibleEnd}. ${count} of ${groups.length} generated; ${remaining} remaining.` : `Showing lessons ${visibleStart + 1}–${visibleEnd}. All ${groups.length} lessons generated.`;
        if (nextButton) nextButton.hidden = remaining === 0; if (nextThreeButton) nextThreeButton.hidden = remaining === 0;
        if (previousButton) previousButton.hidden = visibleStart === 0;
      }
      if (nextThreeButton) nextThreeButton.textContent = `Generate next ${Math.min(3, Math.max(0, groups.length - count))} lessons`;
    };

    const generateRange = async (amount: number) => {
      if (!isLessonGenerationConfigured()) { if (status) status.textContent = "Lesson generation is not configured."; return; }
      const start = generatedCount(); const targets = groups.slice(start, start + amount); if (!targets.length) return;
      list.replaceChildren(); visibleStart = start; visibleAmount = targets.length; goTop();
      [generateButton, clearButton, previousButton, nextButton, nextThreeButton].forEach((button) => { if (button) button.disabled = true; });
      if (progress) progress.hidden = false; if (status) status.textContent = "";
      try {
        for (let offset = 0; offset < targets.length; offset += 1) {
          const group = targets[offset]; const lessonNumber = start + offset + 1;
          if (progressLabel) progressLabel.textContent = `Generating lesson ${lessonNumber}: ${group.title}`; if (progressCount) progressCount.textContent = `${offset + 1} / ${targets.length}`; if (progressBar) progressBar.style.width = `${Math.round((offset / targets.length) * 100)}%`; if (progressDetail) progressDetail.textContent = "Please keep this tab open. Earlier lessons remain saved and can be reopened with Previous lesson.";
          const lesson = await generateLesson({ curriculumTitle: stored.curriculum.title, sectionTitle: group.title, sourceText: lessonGroupSource(group), objectivesText: sections.filter((section) => section.role.role === "objectives").map((section) => section.sourceText).join("\n\n"), neighboringContext: "" });
          sessionStorage.setItem(cacheKey(stored.curriculum.id, group.id), JSON.stringify(lesson)); redraw();
        }
        if (progressLabel) progressLabel.textContent = "Generation complete"; if (progressBar) progressBar.style.width = "100%"; if (progressDetail) progressDetail.textContent = "The newly generated lesson content is shown below."; if (status) status.textContent = `${generatedCount()} of ${groups.length} lessons generated.`; goTop();
      } catch (error) { if (progressLabel) progressLabel.textContent = "Generation stopped"; if (status) status.textContent = error instanceof Error ? error.message : "Lesson generation failed."; }
      finally { [generateButton, clearButton, previousButton, nextButton, nextThreeButton].forEach((button) => { if (button) button.disabled = false; }); redraw(); }
    };

    generateButton?.addEventListener("click", () => generateRange(3)); nextButton?.addEventListener("click", () => generateRange(1)); nextThreeButton?.addEventListener("click", () => generateRange(3));
    previousButton?.addEventListener("click", () => { if (visibleStart <= 0) return; visibleStart = Math.max(0, visibleStart - 1); visibleAmount = 1; if (progress) progress.hidden = true; redraw(); goTop(); });
    exportSequenceButton?.addEventListener("click", () => { const parts = [`# ${stored.curriculum.title} — Learn sequence`, ""]; groups.slice(0, generatedCount()).forEach((group,index)=>{const lesson=getCachedLesson(group);if(lesson)parts.push(lessonMarkdown(group,lesson,index),"","---","");}); downloadText(`${slugify(stored.curriculum.title)}-learn-sequence.md`, parts.join("\n")); });
    clearButton?.addEventListener("click", () => { groups.forEach((group) => sessionStorage.removeItem(cacheKey(stored.curriculum.id, group.id))); visibleStart = 0; visibleAmount = Math.min(3, groups.length); if (status) status.textContent = "Generated sequence cleared."; if (progress) progress.hidden = true; redraw(); goTop(); });
    redraw();
  }
</script>

<style>
.sequence-shell{padding-bottom:4rem}.sequence-actions,.queue-buttons{display:flex;gap:.65rem;flex-wrap:wrap;margin:1rem 0}.sequence-status{color:var(--text-muted)}.generation-progress,.queue-actions{max-width:var(--reading-width);margin:1rem 0;padding:1rem;border:1px solid var(--border);border-radius:.75rem;background:var(--surface-alt)}.generation-progress-heading{display:flex;justify-content:space-between;gap:1rem}.generation-progress-track{height:.6rem;margin:.75rem 0;border-radius:999px;overflow:hidden;background:var(--border)}.generation-progress-track span{display:block;width:0;height:100%;background:var(--accent);transition:width .25s}.group-list{display:grid;gap:1rem;max-width:var(--reading-width)}.sequence-card{padding:1.1rem;border:1px solid var(--border);border-radius:.8rem;background:var(--surface)}.sequence-card-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.sequence-card h2{margin:.2rem 0 .55rem}.sequence-card h3{margin:1rem 0 .35rem;font-size:1rem}.sequence-card details{margin-top:1rem}.sequence-card details summary{cursor:pointer;font-weight:650}.sequence-card details p{line-height:1.65}.group-source-count{margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--border);color:var(--text-muted);font-size:.88rem}.lesson-eyebrow{margin:0;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted)}.learning-goal{color:var(--text-muted)}.compact-button{padding:.45rem .65rem;font-size:.85rem}@media(max-width:620px){.sequence-card-heading{display:grid}.queue-buttons button{width:100%;text-align:left}}
</style>
