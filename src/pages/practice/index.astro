---
import Layout from "../../layouts/Layout.astro";
import QuizQuestion from "../../components/QuizQuestion.astro";
import {
    automationBasicsQuestions,
    apiBasicsQuestions,
} from "../../data/questions";
import {
    PRACTICE_MODES,
    getModeLabel,
    getModeDescription,
    getModeIcon,
} from "../../data/practice-modes";

const practiceQuestions = [...automationBasicsQuestions, ...apiBasicsQuestions];

---

<Layout title="Practice | Aaron Holmes">
    <main class="container" data-session-length={Math.min(practiceQuestions.length, 5)}>
        <div class="practice-links">
            <a href="/learn">← Back to Learn</a>
            <a href="/progress">View progress</a>
        </div>

        <h1>Practice</h1>

        <div id="practice-mode-selector" class="practice-mode-selector">
            {
                Object.entries(PRACTICE_MODES).map(([modeId, mode]) => (
                    <button
                        class="practice-mode-button"
                        data-mode={modeId}
                        type="button"
                        title={mode.description}
                    >
                        <span class="mode-icon">{mode.icon}</span>
                        <span class="mode-label">{mode.label}</span>
                    </button>
                ))
            }
        </div>

        <div id="practice-mode-info">
            <p id="practice-description">
                Review questions across all topics.
            </p>
        </div>

        <div class="practice-session-length">
            <label for="session-length-select">Session length</label>
            <select id="session-length-select">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="all">All</option>
            </select>
        </div>

        <div id="practice-empty-state" class="practice-empty-state" hidden>
            <p>
                No questions available in this mode yet. Complete more practice sessions to build up your weak concept history.
            </p>
            <a href="/practice?mode=all" class="new-session-button">Try another mode</a>
        </div>

        <div class="practice-meta">
            <p id="question-progress" aria-live="polite">
                <span>Question</span>
                <strong id="current-question-number">1</strong>
                <span>of</span>
                <strong id="session-length">{Math.min(practiceQuestions.length, 5)}</strong>
            </p>

            <p class="practice-score">
                <span>Score:</span>
                <strong id="practice-score">0</strong>
                <span>/</span>
                <strong id="answered-count">0</strong>
            </p>
        </div>

        <div id="practice-questions">
            {
                practiceQuestions.map((question) => (
                    <div hidden data-session-question>
                        <QuizQuestion question={question} mode="practice" />
                    </div>
                ))
            }
        </div>

        <div id="next-question-container" class="practice-actions" hidden>
            <button id="next-question" class="new-session-button" type="button" hidden>
                Next question
            </button>
        </div>

        <section
            id="session-complete"
            class="practice-complete"
            hidden
            aria-labelledby="complete-heading"
        >
            <h2 id="complete-heading">Session complete</h2>
            <p>
                Final score: <strong id="final-score">0</strong> /
                <strong id="final-answered">0</strong>
            </p>
            <p>Accuracy: <strong id="final-accuracy">0%</strong></p>
            <a id="new-session" class="new-session-button" href="/practice">New session</a>
        </section>
    </main>
</Layout>

<script>
    import { savePracticeAttempt, readPracticeAttempts } from "../../data/attempts";
    import {
        filterQuestionsByMode,
        getWeakConceptsFromAttempts,
        getModeLabel,
        getModeDescription,
        PRACTICE_MODES,
    } from "../../data/practice-modes";

    const practiceScore =
        document.querySelector<HTMLElement>("#practice-score");

    const answeredCount =
        document.querySelector<HTMLElement>("#answered-count");

    const answeredQuestions = new Set<string>();

    const sessionComplete =
        document.querySelector<HTMLElement>("#session-complete");

    const nextQuestion =
        document.querySelector<HTMLButtonElement>("#next-question");
    const nextQuestionContainer = document.querySelector<HTMLElement>(
        "#next-question-container",
    );

    const currentQuestionNumber = document.querySelector<HTMLElement>(
        "#current-question-number",
    );

    const finalScore = document.querySelector<HTMLElement>("#final-score");
    const finalAnswered =
        document.querySelector<HTMLElement>("#final-answered");
    const finalAccuracy =
        document.querySelector<HTMLElement>("#final-accuracy");
    const sessionLengthSelect =
        document.querySelector<HTMLSelectElement>("#session-length-select");
    const newSession = document.querySelector<HTMLAnchorElement>("#new-session");
    const sessionCandidates = Array.from(
        document.querySelectorAll<HTMLElement>("[data-session-question]"),
    );

    const modeButtons = document.querySelectorAll<HTMLButtonElement>(
        ".practice-mode-button",
    );
    const practiceDescription = document.getElementById("practice-description");
    const practiceEmptyState = document.getElementById("practice-empty-state");

    const searchParams = new URLSearchParams(window.location.search);
    const mode = searchParams.get("mode") ?? "all";
    const topic = searchParams.get("topic");
    const requestedLength = searchParams.get("length");
    const validLengths = ["5", "10", "20", "all"];
    const selectedLength = validLengths.includes(requestedLength ?? "")
        ? requestedLength!
        : "5";

    // Update mode selector UI
    modeButtons.forEach((button) => {
        const btnMode = button.dataset.mode ?? "";
        button.classList.toggle("active", btnMode === mode);
        button.addEventListener("click", () => {
            const newUrl = `/practice?mode=${btnMode}`;
            window.location.href = newUrl;
        });
    });



    // Update description
    if (practiceDescription) {
        practiceDescription.textContent = getModeDescription(mode);
    }

    if (sessionLengthSelect) {
        sessionLengthSelect.value = selectedLength;
    }

    const buildPracticeUrl = (
        nextMode: string | null,
        nextTopic: string | null,
        nextLength: string,
    ) => {
        const params = new URLSearchParams();

        const modeToUse = nextMode ?? mode;
        if (modeToUse && modeToUse !== "all") {
            params.set("mode", modeToUse);
        }

        if (nextTopic && nextTopic !== "all") {
            params.set("topic", nextTopic);
        }

        if (nextLength !== "5") {
            params.set("length", nextLength);
        }

        const query = params.toString();
        return query ? `/practice?${query}` : "/practice";
    };

    if (newSession) {
        newSession.href = buildPracticeUrl(mode, topic, selectedLength);
    }

    // Get all questions rendered in the page
    const allQuizQuestions = Array.from(
        document.querySelectorAll<HTMLElement>(".quiz-question"),
    );

    // Filter questions by mode (client-side weak concepts calculation)
    let filteredByMode: HTMLElement[] = [];
    if (mode === "weak") {
        const attempts = readPracticeAttempts();
        const weakConcepts = getWeakConceptsFromAttempts(attempts);

        if (weakConcepts.length === 0) {
            // No weak concepts yet
            if (practiceEmptyState) {
                practiceEmptyState.hidden = false;
            }
            filteredByMode = [];
        } else {
            // Filter sessionCandidates to only those with weak concepts
            filteredByMode = sessionCandidates.filter((question) => {
                const quiz = question.querySelector<HTMLElement>(".quiz-question");
                const concepts = quiz?.dataset.concepts?.split(",") ?? [];
                return concepts.some((c) => weakConcepts.includes(c));
            });
        }
    } else {
        // Apply mode-based filtering to candidates
        filteredByMode = sessionCandidates.filter((question) => {
            const quiz = question.querySelector<HTMLElement>(".quiz-question");
            if (!quiz) return false;

            // Apply topic filter for "all" mode
            if (mode === "all" && topic) {
                if (quiz.dataset.topic !== topic) {
                    return false;
                }
            }

            // For non-"all" modes, apply the mode-specific filters
            if (mode !== "all") {
                // Reconstruct minimal question object for filtering
                const concepts = quiz.dataset.concepts?.split(",") ?? [];
                const learningStage = quiz.dataset.learningStage ?? "";

                // Check if this question matches the mode filters
                if (mode === "interview") {
                    // Favor application/understanding
                    if (
                        learningStage !== "application" &&
                        learningStage !== "understanding"
                    ) {
                        // Still include recognition, but less frequently
                        return true;
                    }
                }

                if (mode === "api-auth") {
                    // Filter to auth-related concepts
                    const authConcepts = [
                        "api-keys",
                        "headers",
                        "bearer-tokens",
                        "oauth-2",
                        "access-tokens",
                        "refresh-tokens",
                        "jwt",
                        "authentication",
                        "authorization",
                        "status-codes",
                        "rate-limits",
                        "pagination",
                        "idempotency",
                        "request-response",
                        "http-methods",
                    ];

                    if (quiz.dataset.topic !== "api") {
                        return false;
                    }

                    if (
                        !concepts.some((c) => authConcepts.includes(c))
                    ) {
                        return false;
                    }
                }

                if (mode === "automation") {
                    if (quiz.dataset.topic !== "automation") {
                        return false;
                    }
                }
            }

            return true;
        });
    }

    // Randomize and slice
    const sessionQuestions = filteredByMode
        .sort(() => Math.random() - 0.5)
        .slice(0, selectedLength === "all" ? undefined : Number(selectedLength));

    // Hide all, then show only the current question
    sessionCandidates.forEach((question) => {
        const sessionIndex = sessionQuestions.indexOf(question);
        question.hidden = sessionIndex !== 0;
    });

    const sessionLength = sessionQuestions.length;
    const sessionLengthElement = document.querySelector<HTMLElement>(
        "#session-length",
    );
    if (sessionLengthElement) {
        sessionLengthElement.textContent = sessionLength.toString();
    }

    let correctAnswers = 0;
    let totalAnswered = 0;
    let currentQuestionIndex = 0;

    document.addEventListener("question-answered", (event) => {
        const customEvent = event as CustomEvent<{
            questionId?: string;
            answerId?: string;
            correct: boolean;
        }>;

        const questionId = customEvent.detail.questionId;
        const answerId = customEvent.detail.answerId;

        if (!questionId || !answerId || answeredQuestions.has(questionId)) {
            return;
        }

        answeredQuestions.add(questionId);

        const quiz = (event.target as HTMLElement | null)?.closest<HTMLElement>(
            ".quiz-question",
        );
        const concepts = quiz?.dataset.concepts
            ?.split(",")
            .filter(Boolean);
        const difficulty = quiz?.dataset.difficulty;
        const learningStage = quiz?.dataset.learningStage;

        savePracticeAttempt({
            questionId,
            answerId,
            correct: customEvent.detail.correct,
            answeredAt: new Date().toISOString(),
            ...(quiz?.dataset.topic && { topic: quiz.dataset.topic }),
            ...(concepts?.length && { concepts }),
            ...(difficulty && { difficulty: difficulty as "beginner" | "intermediate" | "advanced" }),
            ...(learningStage && {
                learningStage: learningStage as
                    | "recognition"
                    | "understanding"
                    | "application",
            }),
        });

        totalAnswered += 1;

        if (customEvent.detail.correct) {
            correctAnswers += 1;
        }

        if (practiceScore) {
            practiceScore.textContent = correctAnswers.toString();
        }

        if (answeredCount) {
            answeredCount.textContent = totalAnswered.toString();
        }

        if (totalAnswered === sessionLength) {
            if (finalScore) finalScore.textContent = correctAnswers.toString();
            if (finalAnswered) finalAnswered.textContent = totalAnswered.toString();
            if (finalAccuracy) {
                finalAccuracy.textContent = `${Math.round((correctAnswers / sessionLength) * 100)}%`;
            }
            if (nextQuestion) nextQuestion.textContent = "Finish session";
            if (nextQuestion) nextQuestion.hidden = false;
            if (nextQuestionContainer) nextQuestionContainer.hidden = false;
            return;
        }

        if (nextQuestion) nextQuestion.textContent = "Next question";
        if (nextQuestion) nextQuestion.hidden = false;
        if (nextQuestionContainer) nextQuestionContainer.hidden = false;
    });



    sessionLengthSelect?.addEventListener("change", () => {
        window.location.href = buildPracticeUrl(
            mode,
            topic,
            sessionLengthSelect.value,
        );
    });

    nextQuestion?.addEventListener("click", () => {
        if (!answeredQuestions.has(sessionQuestions[currentQuestionIndex]
            ?.querySelector<HTMLElement>(".quiz-question")?.dataset.questionId ?? "")) {
            return;
        }

        if (currentQuestionIndex === sessionQuestions.length - 1) {
            sessionQuestions[currentQuestionIndex].hidden = true;
            nextQuestion.hidden = true;
            if (nextQuestionContainer) nextQuestionContainer.hidden = true;
            if (sessionComplete) sessionComplete.hidden = false;
            return;
        }

        sessionQuestions[currentQuestionIndex].hidden = true;
        currentQuestionIndex += 1;
        sessionQuestions[currentQuestionIndex].hidden = false;

        if (currentQuestionNumber) {
            currentQuestionNumber.textContent = (currentQuestionIndex + 1).toString();
        }
        nextQuestion.hidden = true;
        if (nextQuestionContainer) nextQuestionContainer.hidden = true;
    });
</script>
