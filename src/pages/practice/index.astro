---
import Layout from "../../layouts/Layout.astro";
import QuizQuestion from "../../components/QuizQuestion.astro";
import {
    automationBasicsQuestions,
    apiBasicsQuestions,
} from "../../data/questions";

const practiceQuestions = [...automationBasicsQuestions, ...apiBasicsQuestions];

---

<Layout title="Practice | Aaron Holmes">
    <main class="container" data-session-length={Math.min(practiceQuestions.length, 5)}>
        <div class="practice-links">
            <a href="/learn">← Back to Learn</a>
            <a href="/progress">View progress</a>
        </div>

        <h1>Practice</h1>

        <nav class="practice-filters" aria-label="Practice topics">
            <button
                class="active"
                type="button"
                data-topic-filter="all">All topics</button
            >
            <button
                type="button"
                data-topic-filter="automation">Automation</button
            >
            <button
                type="button"
                data-topic-filter="api">API</button
            >
        </nav>

        <p>
            Review questions across topics without going through the full
            lessons.
        </p>

        <div class="practice-meta">
            <p id="question-progress" aria-live="polite">
                <span>Question</span>
                <strong id="current-question-number">1</strong>
                <span>of</span>
                <strong id="session-length">{Math.min(practiceQuestions.length, 5)}</strong>
            </p>

            <p class="practice-score">
                <span>Score:</span>
                <strong id="practice-score">0</strong>
                <span>/</span>
                <strong id="answered-count">0</strong>
            </p>
        </div>

        <div id="practice-questions">
            {
                practiceQuestions.map((question) => (
                    <div hidden data-session-question>
                        <QuizQuestion question={question} mode="practice" />
                    </div>
                ))
            }
        </div>

        <div id="next-question-container" class="practice-actions" hidden>
            <button id="next-question" class="new-session-button" type="button" hidden>
                Next question
            </button>
        </div>

        <section
            id="session-complete"
            class="practice-complete"
            hidden
            aria-labelledby="complete-heading"
        >
            <h2 id="complete-heading">Session complete</h2>
            <p>
                Final score: <strong id="final-score">0</strong> /
                <strong id="final-answered">0</strong>
            </p>
            <p>Accuracy: <strong id="final-accuracy">0%</strong></p>
            <a class="new-session-button" href="/practice">New session</a>
        </section>
    </main>
</Layout>

<script>
    import { savePracticeAttempt } from "../../data/attempts";

    const practiceScore =
        document.querySelector<HTMLElement>("#practice-score");

    const answeredCount =
        document.querySelector<HTMLElement>("#answered-count");

    const answeredQuestions = new Set<string>();

    const sessionComplete =
        document.querySelector<HTMLElement>("#session-complete");

    const nextQuestion =
        document.querySelector<HTMLButtonElement>("#next-question");
    const nextQuestionContainer = document.querySelector<HTMLElement>(
        "#next-question-container",
    );

    const currentQuestionNumber = document.querySelector<HTMLElement>(
        "#current-question-number",
    );

    const finalScore = document.querySelector<HTMLElement>("#final-score");
    const finalAnswered =
        document.querySelector<HTMLElement>("#final-answered");
    const finalAccuracy =
        document.querySelector<HTMLElement>("#final-accuracy");
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-topic-filter]",
    );
    const sessionCandidates = Array.from(
        document.querySelectorAll<HTMLElement>("[data-session-question]"),
    );

    const topic = new URLSearchParams(window.location.search).get("topic");
    filterButtons.forEach((button) => {
        button.classList.toggle(
            "active",
            (button.dataset.topicFilter ?? "all") === (topic ?? "all"),
        );
    });

    const sessionQuestions = sessionCandidates
        .filter((question) => {
            return (
                !topic ||
                question.querySelector<HTMLElement>(".quiz-question")?.dataset
                    .topic === topic
            );
        })
        .sort(() => Math.random() - 0.5)
        .slice(0, 5);

    sessionCandidates.forEach((question) => {
        const sessionIndex = sessionQuestions.indexOf(question);
        question.hidden = sessionIndex !== 0;
    });

    const sessionLength = sessionQuestions.length;
    const sessionLengthElement = document.querySelector<HTMLElement>(
        "#session-length",
    );
    if (sessionLengthElement) {
        sessionLengthElement.textContent = sessionLength.toString();
    }

    let correctAnswers = 0;
    let totalAnswered = 0;
    let currentQuestionIndex = 0;

    document.addEventListener("question-answered", (event) => {
        const customEvent = event as CustomEvent<{
            questionId?: string;
            answerId?: string;
            correct: boolean;
        }>;

        const questionId = customEvent.detail.questionId;
        const answerId = customEvent.detail.answerId;

        if (!questionId || !answerId || answeredQuestions.has(questionId)) {
            return;
        }

        answeredQuestions.add(questionId);

        const quiz = (event.target as HTMLElement | null)?.closest<HTMLElement>(
            ".quiz-question",
        );
        const concepts = quiz?.dataset.concepts
            ?.split(",")
            .filter(Boolean);

        savePracticeAttempt({
            questionId,
            answerId,
            correct: customEvent.detail.correct,
            answeredAt: new Date().toISOString(),
            ...(quiz?.dataset.topic && { topic: quiz.dataset.topic }),
            ...(concepts?.length && { concepts }),
        });

        totalAnswered += 1;

        if (customEvent.detail.correct) {
            correctAnswers += 1;
        }

        if (practiceScore) {
            practiceScore.textContent = correctAnswers.toString();
        }

        if (answeredCount) {
            answeredCount.textContent = totalAnswered.toString();
        }

        if (totalAnswered === sessionLength) {
            sessionQuestions[currentQuestionIndex].hidden = true;
            if (finalScore) finalScore.textContent = correctAnswers.toString();
            if (finalAnswered) finalAnswered.textContent = totalAnswered.toString();
            if (finalAccuracy) {
                finalAccuracy.textContent = `${Math.round((correctAnswers / sessionLength) * 100)}%`;
            }
            if (sessionComplete) sessionComplete.hidden = false;
            if (nextQuestion) nextQuestion.hidden = true;
            if (nextQuestionContainer) nextQuestionContainer.hidden = true;
            return;
        }

        if (nextQuestion) nextQuestion.hidden = false;
        if (nextQuestionContainer) nextQuestionContainer.hidden = false;
    });

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const selectedTopic = button.dataset.topicFilter;

            window.location.href =
                selectedTopic === "all"
                    ? "/practice"
                    : `/practice?topic=${encodeURIComponent(selectedTopic ?? "")}`;
        });
    });

    nextQuestion?.addEventListener("click", () => {
        if (!answeredQuestions.has(sessionQuestions[currentQuestionIndex]
            ?.querySelector<HTMLElement>(".quiz-question")?.dataset.questionId ?? "")) {
            return;
        }

        sessionQuestions[currentQuestionIndex].hidden = true;
        currentQuestionIndex += 1;
        sessionQuestions[currentQuestionIndex].hidden = false;

        if (currentQuestionNumber) {
            currentQuestionNumber.textContent = (currentQuestionIndex + 1).toString();
        }
        nextQuestion.hidden = true;
        if (nextQuestionContainer) nextQuestionContainer.hidden = true;
    });
</script>
