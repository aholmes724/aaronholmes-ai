---
import Layout from "../../layouts/Layout.astro";
import QuizQuestion from "../../components/QuizQuestion.astro";
import { allQuestions } from "../../data/questions";
import { PRACTICE_MODES } from "../../data/practice-modes";

const practiceQuestions = allQuestions;
---

<Layout title="Practice | Aaron Holmes">
    <main
        class="container"
        data-session-length={Math.min(practiceQuestions.length, 5)}
    >
        <div class="practice-links">
            <a href="/learn">← Back to Learn</a>
            <a href="/progress">View progress</a>
        </div>

        <h1>Practice</h1>

        <div id="practice-mode-selector" class="practice-mode-selector">
            {
                Object.entries(PRACTICE_MODES).map(([modeId, mode]) => (
                    <button
                        class="practice-mode-button"
                        data-mode={modeId}
                        type="button"
                        title={mode.description}
                    >
                        <span class="mode-icon">{mode.icon}</span>
                        <span class="mode-label">{mode.label}</span>
                    </button>
                ))
            }
        </div>

        <div id="practice-mode-info">
            <p id="practice-description">Review questions across all topics.</p>
        </div>

        <div class="practice-session-length">
            <label for="session-length-select">Session length</label>
            <select id="session-length-select">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="all">All</option>
            </select>
        </div>

        <div id="practice-empty-state" class="practice-empty-state" hidden>
            <p>
                No questions available in this mode yet. Complete more practice
                sessions to build up your weak concept history.
            </p>
            <a href="/practice?mode=all" class="new-session-button"
                >Try another mode</a
            >
        </div>

        <div class="practice-meta">
            <p id="question-progress" aria-live="polite">
                <span>Question</span>
                <strong id="current-question-number">1</strong>
                <span>of</span>
                <strong id="session-length"
                    >{Math.min(practiceQuestions.length, 5)}</strong
                >
            </p>

            <p class="practice-score">
                <span>Score:</span>
                <strong id="practice-score">0</strong>
                <span>/</span>
                <strong id="answered-count">0</strong>
            </p>
        </div>

        <div id="practice-questions">
            {
                practiceQuestions.map((question) => (
                    <div hidden data-session-question>
                        <QuizQuestion question={question} mode="practice" />
                    </div>
                ))
            }
        </div>

        <div id="next-question-container" class="practice-actions" hidden>
            <button
                id="next-question"
                class="new-session-button"
                type="button"
                hidden
            >
                Next question
            </button>
        </div>

        <section
            id="session-complete"
            class="practice-complete"
            hidden
            aria-labelledby="complete-heading"
        >
            <h2 id="complete-heading">Session complete</h2>
            <p>
                Final score: <strong id="final-score">0</strong> /
                <strong id="final-answered">0</strong>
            </p>
            <p>Accuracy: <strong id="final-accuracy">0%</strong></p>
            <a id="new-session" class="new-session-button" href="/practice"
                >New session</a
            >
        </section>
    </main>
</Layout>

<script>
    import "../../scripts/practice-client";
</script>
