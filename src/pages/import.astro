---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Import Curriculum | Aaron Holmes">
    <main class="container">
        <div class="practice-links"><a href="/learning">← Learning</a><a href="/practice">Practice</a></div>
        <h1>Import curriculum</h1>
        <p>Bring source material into the learning engine without editing TypeScript question files.</p>

        <section class="progress-summary">
            <h2>Source material</h2>
            <p>Upload plain text or Markdown to create a curriculum structure, or load an existing portable JSON curriculum package.</p>
            <label for="curriculum-file"><strong>Choose .txt, .md, or curriculum .json</strong></label>
            <input id="curriculum-file" type="file" accept="text/plain,text/markdown,application/json,.txt,.md,.markdown,.json" />
            <div class="progress-actions"><button id="load-sample" class="secondary-button" type="button">Load sample package</button></div>
        </section>

        <section id="import-result" class="progress-summary" aria-live="polite">
            <h2>Import check</h2>
            <p>No curriculum loaded yet.</p>
        </section>
    </main>
</Layout>

<script>
    import type { CurriculumPackage } from "../data/curriculum/types";
    import { parseCurriculumJson, summarizeCurriculum } from "../data/curriculum/importer";
    import { sampleCurriculum } from "../data/curriculum/sample";
    import { saveImportedCurriculum } from "../data/curriculum/storage";
    import { ingestTextSource } from "../data/curriculum/source-ingestion";
    import { createQuestionGenerationRequest } from "../data/curriculum/generation-contract";
    import { generateQuestionDrafts, isQuestionGenerationConfigured, mergeGeneratedDrafts } from "../data/curriculum/generation-client";
    import { validateGeneratedDrafts } from "../data/curriculum/generation-harness";

    const input = document.querySelector<HTMLInputElement>("#curriculum-file");
    const sampleButton = document.querySelector<HTMLButtonElement>("#load-sample");
    const result = document.querySelector<HTMLElement>("#import-result");
    let pendingCurriculum: CurriculumPackage | null = null;
    let pendingSourceText = "";
    let pendingSourceSummary = "";

    const renderPackage = (curriculum: CurriculumPackage, sourceText = "", sourceSummary?: string, generationMessage?: string) => {
        if (!result) return;
        pendingCurriculum = curriculum;
        pendingSourceText = sourceText;
        pendingSourceSummary = sourceSummary ?? pendingSourceSummary;
        const stats = summarizeCurriculum(curriculum);
        const heading = document.createElement("h2");
        heading.textContent = "Import check";
        const title = document.createElement("p");
        title.innerHTML = `<strong>${curriculum.title}</strong> · version ${curriculum.version}`;
        const dl = document.createElement("dl");
        dl.className = "progress-stats";
        const entries = [
            ["Sources", stats.sources], ["Concepts", stats.concepts], ["Objectives", stats.objectives],
            ["Question drafts", stats.drafts], ["Approved", stats.approved],
        ];
        entries.forEach(([labelText, value]) => {
            const wrapper = document.createElement("div");
            const dt = document.createElement("dt");
            const dd = document.createElement("dd");
            dt.textContent = String(labelText);
            dd.textContent = String(value);
            wrapper.append(dt, dd);
            dl.append(wrapper);
        });

        const note = document.createElement("p");
        note.textContent = generationMessage || (stats.approved
            ? "Grounded questions are ready. Save this curriculum to make them available for practice."
            : "Source structure is ready. Generate grounded questions next; this package has no approved questions yet.");

        const actions = document.createElement("div");
        actions.className = "progress-actions";

        if (sourceText && !stats.approved) {
            const generate = document.createElement("button");
            generate.className = "new-session-button";
            generate.type = "button";
            generate.textContent = "Generate grounded questions";
            generate.disabled = !isQuestionGenerationConfigured();
            if (!isQuestionGenerationConfigured()) generate.title = "Supabase generation backend is not configured.";
            generate.addEventListener("click", async () => {
                if (!pendingCurriculum || !pendingSourceText) return;
                generate.disabled = true;
                generate.textContent = "Generating…";
                note.textContent = "Generating source-grounded questions and checking them for obvious quality failures…";

                try {
                    const request = createQuestionGenerationRequest(pendingCurriculum, pendingSourceText);
                    const generated = await generateQuestionDrafts(request);
                    if (!generated.ok) {
                        renderPackage(
                            pendingCurriculum,
                            pendingSourceText,
                            pendingSourceSummary,
                            generated.suitability === "blocked"
                                ? `This source was not converted into a study set: ${generated.message || "The material is not suitable for generated practice."}`
                                : generated.message || "Question generation failed.",
                        );
                        return;
                    }

                    const harness = validateGeneratedDrafts(pendingCurriculum, generated.drafts);
                    if (!harness.accepted.length) {
                        renderPackage(
                            pendingCurriculum,
                            pendingSourceText,
                            pendingSourceSummary,
                            "The model returned questions, but none passed the grounding and quality checks. Nothing was saved.",
                        );
                        return;
                    }

                    const merged = mergeGeneratedDrafts(pendingCurriculum, harness.accepted);
                    const warningCount = generated.warnings.length + harness.issues.filter((issue) => issue.severity === "warning").length;
                    const rejectedCount = generated.rejectedCount + harness.rejected.length;
                    const message = `${harness.accepted.length} grounded question${harness.accepted.length === 1 ? "" : "s"} passed the v1 harness.` +
                        (rejectedCount ? ` ${rejectedCount} draft${rejectedCount === 1 ? " was" : "s were"} rejected.` : "") +
                        (warningCount ? ` ${warningCount} quality warning${warningCount === 1 ? " remains" : "s remain"} for later review.` : "");
                    renderPackage(merged, pendingSourceText, pendingSourceSummary, message);
                } catch (error) {
                    renderPackage(
                        pendingCurriculum,
                        pendingSourceText,
                        pendingSourceSummary,
                        error instanceof Error ? error.message : "Question generation failed unexpectedly.",
                    );
                }
            });
            actions.append(generate);
        }

        const save = document.createElement("button");
        save.className = stats.approved ? "new-session-button" : "secondary-button";
        save.type = "button";
        save.textContent = stats.approved ? "Save generated curriculum" : "Save curriculum structure";
        save.addEventListener("click", () => {
            if (!pendingCurriculum) return;
            saveImportedCurriculum(pendingCurriculum);
            const confirmation = document.createElement("p");
            confirmation.textContent = stats.approved
                ? "Saved in this browser. Approved questions are ready for practice."
                : "Saved in this browser. This curriculum structure is ready for generation later.";
            const nextAction = document.createElement("a");
            nextAction.className = "new-session-button";
            nextAction.href = stats.approved ? "/practice/imported" : "/import";
            nextAction.textContent = stats.approved ? "Practice this curriculum" : "Curriculum saved";
            actions.replaceChildren(nextAction);
            note.replaceWith(confirmation);
        });
        actions.append(save);

        const children: Node[] = [heading, title];
        if (sourceSummary) {
            const summary = document.createElement("p");
            summary.textContent = sourceSummary;
            children.push(summary);
        }
        children.push(dl, note, actions);

        if (sourceText) {
            const request = createQuestionGenerationRequest(curriculum, sourceText);
            const generation = document.createElement("details");
            generation.className = "concept-details";
            const summary = document.createElement("summary");
            summary.textContent = "Generation brief";
            const body = document.createElement("div");
            body.className = "progress-summary";
            const target = document.createElement("p");
            target.textContent = `Target: ${request.targetQuestionCount} questions across ${curriculum.learningObjectives.length} learning objective${curriculum.learningObjectives.length === 1 ? "" : "s"}.`;
            const guidance = document.createElement("ul");
            request.qualityGuidance.forEach((item) => {
                const li = document.createElement("li");
                li.textContent = item;
                guidance.append(li);
            });
            body.append(target, guidance);
            generation.append(summary, body);
            children.push(generation);
        }

        result.replaceChildren(...children);
    };

    const renderJson = (raw: string) => {
        if (!result) return;
        const imported = parseCurriculumJson(raw);
        pendingCurriculum = null;
        pendingSourceText = "";
        pendingSourceSummary = "";
        if (!imported.ok || !imported.curriculum) {
            const heading = document.createElement("h2");
            heading.textContent = "Import check";
            const intro = document.createElement("p");
            intro.textContent = "This package needs attention before it can enter the learning engine.";
            const list = document.createElement("ul");
            imported.errors.forEach((error) => {
                const item = document.createElement("li");
                item.textContent = error;
                list.append(item);
            });
            result.replaceChildren(heading, intro, list);
            return;
        }
        renderPackage(imported.curriculum);
    };

    input?.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (!file) return;
        const raw = await file.text();
        const isJson = file.name.toLowerCase().endsWith(".json") || file.type === "application/json";
        if (isJson) {
            renderJson(raw);
            return;
        }
        if (!raw.trim()) {
            if (result) result.innerHTML = "<h2>Import check</h2><p>This source file is empty.</p>";
            return;
        }
        const ingested = ingestTextSource({ fileName: file.name, text: raw, mimeType: file.type });
        const summary = `${ingested.wordCount} words · ${ingested.sections.length} source section${ingested.sections.length === 1 ? "" : "s"} detected. Markdown headings become initial curriculum concepts.`;
        renderPackage(ingested.curriculum, raw, summary);
    });

    sampleButton?.addEventListener("click", () => renderJson(JSON.stringify(sampleCurriculum)));
</script>
