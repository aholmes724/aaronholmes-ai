---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Progress | Aaron Holmes">
    <main class="container">
        <a href="/learn">← Back to Learn</a>
        <h1>Progress</h1>
        <p>Practice history from this browser.</p>

        <section class="progress-summary" aria-labelledby="summary-heading">
            <h2 id="summary-heading">Summary</h2>
            <dl class="progress-stats">
                <div>
                    <dt>Total attempts</dt>
                    <dd id="total-attempts">0</dd>
                </div>
                <div>
                    <dt>Total correct</dt>
                    <dd id="total-correct">0</dd>
                </div>
                <div>
                    <dt>Overall accuracy</dt>
                    <dd id="overall-accuracy">0%</dd>
                </div>
            </dl>
        </section>

        <section aria-labelledby="sessions-heading">
            <h2 id="sessions-heading">Recent sessions</h2>
            <div id="session-history" class="progress-list">
                <p>No completed sessions yet.</p>
            </div>
        </section>

        <section aria-labelledby="topic-heading">
            <h2 id="topic-heading">Accuracy by topic</h2>
            <div id="topic-progress" class="progress-list">
                <p>No practice attempts yet.</p>
            </div>
        </section>

        <section aria-labelledby="concept-heading">
            <h2 id="concept-heading">Accuracy by concept</h2>
            <div id="concept-progress" class="progress-list">
                <p>No concept data yet.</p>
            </div>
        </section>

        <div class="progress-actions">
            <a class="new-session-button" href="/practice">Practice again</a>
            <button id="reset-progress" class="reset-progress-button" type="button">
                Reset all progress
            </button>
        </div>

        <section
            id="reset-confirmation"
            class="reset-confirmation"
            hidden
            aria-labelledby="reset-heading"
        >
            <h2 id="reset-heading">Reset all progress?</h2>
            <p>
                This will delete all saved Practice attempt history on this
                device. This cannot be undone.
            </p>
            <div class="progress-actions">
                <button id="confirm-reset" class="reset-progress-button" type="button">
                    Confirm reset
                </button>
                <button id="cancel-reset" class="secondary-button" type="button">
                    Cancel
                </button>
            </div>
        </section>
    </main>
</Layout>

<script>
    import {
        clearPracticeAttempts,
        readPracticeAttempts,
        readSessionSummaries,
    } from "../data/attempts";
    import { PRACTICE_MODES } from "../data/practice-modes";

    const setText = (id: string, value: string) => {
        const element = document.querySelector<HTMLElement>(`#${id}`);
        if (element) element.textContent = value;
    };

    const renderBreakdown = (
        containerId: string,
        groups: Map<string, { attempts: number; correct: number }>,
        emptyMessage: string,
    ) => {
        const container = document.querySelector<HTMLElement>(`#${containerId}`);
        if (!container) return;

        if (!groups.size) {
            container.innerHTML = `<p>${emptyMessage}</p>`;
            return;
        }

        container.replaceChildren(
            ...Array.from(groups.entries())
                .sort(([first], [second]) => first.localeCompare(second))
                .map(([name, result]) => {
                    const item = document.createElement("div");
                    item.className = "progress-item";
                    const percentage = Math.round(
                        (result.correct / result.attempts) * 100,
                    );
                    const label = document.createElement("strong");
                    label.textContent = name;
                    const score = document.createElement("span");
                    score.textContent = `${result.correct}/${result.attempts} (${percentage}%)`;
                    item.append(label, score);
                    return item;
                }),
        );
    };

    const renderSessionHistory = () => {
        const container = document.querySelector<HTMLElement>("#session-history");
        if (!container) return;

        const sessions = [...readSessionSummaries()].sort(
            (first, second) =>
                new Date(second.completedAt).getTime() -
                new Date(first.completedAt).getTime(),
        );

        if (!sessions.length) {
            container.innerHTML = "<p>No completed sessions yet.</p>";
            return;
        }

        container.replaceChildren(
            ...sessions.map((session) => {
                const item = document.createElement("div");
                item.className = "progress-item";

                const label = document.createElement("strong");
                label.textContent = PRACTICE_MODES[session.mode]?.label ?? session.mode;

                const score = document.createElement("span");
                const percentage = session.answeredCount
                    ? Math.round((session.correctCount / session.answeredCount) * 100)
                    : 0;
                const completedAt = new Date(session.completedAt).toLocaleString();
                score.textContent = `${session.correctCount}/${session.answeredCount} (${percentage}%) · ${completedAt}`;

                item.append(label, score);
                return item;
            }),
        );
    };

    const renderProgress = () => {
        const attempts = readPracticeAttempts();
        const correctAttempts = attempts.filter((attempt) => attempt.correct).length;
        const accuracy = attempts.length
            ? Math.round((correctAttempts / attempts.length) * 100)
            : 0;

        setText("total-attempts", attempts.length.toString());
        setText("total-correct", correctAttempts.toString());
        setText("overall-accuracy", `${accuracy}%`);

        const topics = new Map<string, { attempts: number; correct: number }>();
        const concepts = new Map<string, { attempts: number; correct: number }>();

        attempts.forEach((attempt) => {
            if (attempt.topic) {
                const result = topics.get(attempt.topic) ?? { attempts: 0, correct: 0 };
                result.attempts += 1;
                if (attempt.correct) result.correct += 1;
                topics.set(attempt.topic, result);
            }

            attempt.concepts?.forEach((concept) => {
                const result = concepts.get(concept) ?? { attempts: 0, correct: 0 };
                result.attempts += 1;
                if (attempt.correct) result.correct += 1;
                concepts.set(concept, result);
            });
        });

        renderBreakdown("topic-progress", topics, "No topic data yet.");
        renderBreakdown("concept-progress", concepts, "No concept data yet.");
        renderSessionHistory();
    };

    const resetProgress = document.querySelector<HTMLButtonElement>("#reset-progress");
    const resetConfirmation = document.querySelector<HTMLElement>("#reset-confirmation");
    const confirmReset = document.querySelector<HTMLButtonElement>("#confirm-reset");
    const cancelReset = document.querySelector<HTMLButtonElement>("#cancel-reset");

    resetProgress?.addEventListener("click", () => {
        if (resetConfirmation) resetConfirmation.hidden = false;
        confirmReset?.focus();
    });

    cancelReset?.addEventListener("click", () => {
        if (resetConfirmation) resetConfirmation.hidden = true;
        resetProgress?.focus();
    });

    confirmReset?.addEventListener("click", () => {
        clearPracticeAttempts();
        renderProgress();
        if (resetConfirmation) resetConfirmation.hidden = true;
        resetProgress?.focus();
    });

    renderProgress();
</script>