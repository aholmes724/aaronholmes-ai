---
import "../styles/global.css";
import "../styles/learn-glossary.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Automation, software, and practical AI projects by Aaron Holmes.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      const savedTheme = localStorage.getItem("aaronholmes.theme");
      document.documentElement.dataset.theme = savedTheme || "dark";

      // Generated lessons are durable in localStorage, while the existing Learn
      // renderers still use sessionStorage as their working cache. Hydrate those
      // entries before deferred page scripts run so returning to Learn does not
      // trigger another model call after a tab/browser restart.
      try {
        for (let index = 0; index < localStorage.length; index += 1) {
          const key = localStorage.key(index);
          if (!key?.startsWith("aaronholmes.lesson-")) continue;
          const value = localStorage.getItem(key);
          if (value && !sessionStorage.getItem(key)) sessionStorage.setItem(key, value);
        }
      } catch {
        // Storage may be unavailable in private/restricted browser contexts.
      }
    </script>

    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/">Aaron Holmes</a>

        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-pressed="false"
          title="Toggle color theme"
        >
          <span class="theme-toggle-label">Dark mode</span>
        </button>
      </div>
    </header>
    <slot />
  </body>
</html>

<script>
  import "../scripts/curriculum-export-controls";
  import "../scripts/learn-glossary-aliases";
  import "../scripts/learn-workflow-controls";
  import "../scripts/learn-sequence-link";
  import "../scripts/sequence-enhancements";
  import "../scripts/lesson-assessment-links";
  import "../scripts/lesson-persistence";

  const themeToggle =
    document.querySelector<HTMLButtonElement>("#theme-toggle");
  const themeToggleLabel = themeToggle?.querySelector<HTMLElement>(
    ".theme-toggle-label",
  );

  const updateThemeToggle = (theme: string) => {
    const isDark = theme === "dark";
    if (themeToggle) themeToggle.setAttribute("aria-pressed", String(isDark));
    if (themeToggleLabel) {
      themeToggleLabel.textContent = isDark ? "Light mode" : "Dark mode";
    }
  };

  updateThemeToggle(document.documentElement.dataset.theme ?? "light");

  themeToggle?.addEventListener("click", () => {
    const nextTheme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("aaronholmes.theme", nextTheme);
    updateThemeToggle(nextTheme);
  });
</script>
