---
interface Props {
    question: string;
    correctAnswer: string;
    incorrectAnswer: string;
    correctFeedback: string;
    incorrectFeedback: string;
}

const {
    question,
    correctAnswer,
    incorrectAnswer,
    correctFeedback,
    incorrectFeedback,
} = Astro.props;
---

<section
    class="quiz-question"
    data-correct-feedback={correctFeedback}
    data-incorrect-feedback={incorrectFeedback}
>
    <h2>{question}</h2>

    <button type="button" data-answer="incorrect">
        {incorrectAnswer}
    </button>

    <button type="button" data-answer="correct">
        {correctAnswer}
    </button>

    <p class="feedback" aria-live="polite"></p>
    <button class="try-again" type="button" hidden> Try again </button>
</section>
<script>
    const quizzes = document.querySelectorAll<HTMLElement>(".quiz-question");

    quizzes.forEach((quiz) => {
        const buttons = quiz.querySelectorAll<HTMLButtonElement>('button[data-answer]');

        const feedback = quiz.querySelector<HTMLElement>(".feedback");

        const tryAgain = quiz.querySelector<HTMLButtonElement>(".try-again");

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                if (!feedback) return;

                const isCorrect = button.dataset.answer === "correct";
                if (!isCorrect && tryAgain) {
                    tryAgain.hidden = false;
                }

                feedback.textContent = isCorrect
                    ? (quiz.dataset.correctFeedback ?? "Correct.")
                    : (quiz.dataset.incorrectFeedback ?? "Not quite.");

                buttons.forEach((quizButton) => {
                    quizButton.disabled = true;

                    tryAgain?.addEventListener("click", () => {
                        buttons.forEach((quizButton) => {
                            quizButton.disabled = false;
                        });

                        if (feedback) {
                            feedback.textContent = "";
                        }

                        tryAgain.hidden = true;
                    });
                });
            });
        });
    });
</script>
