---
import type { Question } from "../data/questions";
import { getLearningObjective } from "../data/questions/learning-objectives";

interface Props {
    question: Question;
    mode?: "lesson" | "practice";
}

const { question, mode = "lesson" } = Astro.props;
const learningObjective = getLearningObjective(
    question.id,
    question.learningObjective,
);
---

<section
    class="quiz-question"
    data-question-id={question.id}
    data-topic={question.topic}
    data-concepts={question.concepts?.join(",")}
    data-difficulty={question.difficulty}
    data-learning-stage={question.learningStage}
    data-mode={mode}
    data-shuffle-answers={question.shuffleAnswers ?? true}
    data-explanation={question.explanation ?? ""}
    data-mastery-concept={question.masteryConcept ?? ""}
    data-learning-objective={learningObjective}
>
    <h2>{question.prompt}</h2>

    <div class="answers">
        {
            question.answers.map((answer) => (
                <label class="answer-option">
                    <input
                        type="radio"
                        name={`question-${question.id}`}
                        value={answer.id}
                        data-answer-id={answer.id}
                        data-correct={answer.correct}
                        data-feedback={answer.feedback}
                    />
                    <span>{answer.text}</span>
                </label>
            ))
        }
    </div>

    <div class="review" hidden aria-live="polite">
        <p class="result"></p>

        <p class="correct-answer" hidden>
            <strong>Correct answer:</strong>{"  "}
            <span></span>
        </p>

        <p class="feedback"></p>
    </div>

    <button class="try-again" type="button" hidden> Try again </button>
</section>

<script>
    const quizzes = document.querySelectorAll<HTMLElement>(".quiz-question");

    quizzes.forEach((quiz) => {
        const answers = quiz.querySelectorAll<HTMLInputElement>(
            "input[data-answer-id]",
        );

        const answerList = Array.from(answers);

        if (quiz.dataset.shuffleAnswers === "true") {
            answerList.sort(() => Math.random() - 0.5);

            answerList.forEach((answer) => {
                const answerOption = answer.closest(".answer-option");
                answerOption?.parentElement?.appendChild(answerOption);
            });
        }

        const review = quiz.querySelector<HTMLElement>(".review");
        const result = quiz.querySelector<HTMLElement>(".result");
        const feedback = quiz.querySelector<HTMLElement>(".feedback");

        const correctAnswerRow =
            quiz.querySelector<HTMLElement>(".correct-answer");

        const correctAnswerText =
            correctAnswerRow?.querySelector<HTMLElement>("span");

        const tryAgain = quiz.querySelector<HTMLButtonElement>(".try-again");

        const correctInput = answerList.find(
            (answer) => answer.dataset.correct === "true",
        );

        const correctOption =
            correctInput?.closest<HTMLElement>(".answer-option");

        const correctText = correctOption
            ?.querySelector<HTMLElement>("span")
            ?.textContent?.trim();

        answers.forEach((answer) => {
            answer.addEventListener("change", () => {
                if (!review || !result || !feedback) return;

                const isCorrect = answer.dataset.correct === "true";
                const questionId = quiz.dataset.questionId;
                const answerId = answer.dataset.answerId;

                quiz.dispatchEvent(
                    new CustomEvent("question-answered", {
                        bubbles: true,
                        detail: {
                            questionId,
                            answerId,
                            correct: isCorrect,
                        },
                    }),
                );

                const selectedOption =
                    answer.closest<HTMLElement>(".answer-option");

                if (selectedOption) {
                    selectedOption.dataset.result = isCorrect
                        ? "correct"
                        : "incorrect";
                }

                if (!isCorrect && correctOption) {
                    correctOption.dataset.result = "correct";
                }

                review.hidden = false;

                result.textContent = isCorrect ? "Correct." : "Not quite.";

                const canonicalExplanation = quiz.dataset.explanation?.trim();

                feedback.textContent = canonicalExplanation || "";

                if (
                    !isCorrect &&
                    correctAnswerRow &&
                    correctAnswerText &&
                    correctText
                ) {
                    correctAnswerText.textContent = correctText;
                    correctAnswerRow.hidden = false;
                } else if (correctAnswerRow) {
                    correctAnswerRow.hidden = true;
                }

                if (
                    !isCorrect &&
                    tryAgain &&
                    quiz.dataset.mode !== "practice"
                ) {
                    tryAgain.hidden = false;
                }

                answers.forEach((quizAnswer) => {
                    quizAnswer.disabled = true;
                });
            });
        });

        tryAgain?.addEventListener("click", () => {
            answers.forEach((quizAnswer) => {
                quizAnswer.disabled = false;
                quizAnswer.checked = false;

                const answerOption =
                    quizAnswer.closest<HTMLElement>(".answer-option");

                if (answerOption) {
                    delete answerOption.dataset.result;
                }
            });

            if (review) {
                review.hidden = true;
            }

            if (result) {
                result.textContent = "";
            }

            if (feedback) {
                feedback.textContent = "";
            }

            if (correctAnswerRow) {
                correctAnswerRow.hidden = true;
            }

            if (correctAnswerText) {
                correctAnswerText.textContent = "";
            }

            tryAgain.hidden = true;
        });
    });
</script>
