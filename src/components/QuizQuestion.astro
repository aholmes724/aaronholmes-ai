---
interface Answer {
    id: string;
    text: string;
    correct: boolean;
    feedback: string;
}

interface Question {
    id: string;
    type: "single-select" | "multi-select";
    prompt: string;
    answers: Answer[];

    topic?: string;
    difficulty?: "beginner" | "intermediate" | "advanced";
    explanation?: string;
    shuffleAnswers?: boolean;
}

interface Props {
    question: Question;
}

const { question } = Astro.props;
---

<section
    class="quiz-question"
    data-shuffle-answers={question.shuffleAnswers ?? true}
>
    <h2>{question.prompt}</h2>

    <div class="answers">
        {
            question.answers.map((answer) => (
                <button
                    type="button"
                    data-answer-id={answer.id}
                    data-correct={answer.correct}
                    data-feedback={answer.feedback}
                >
                    {answer.text}
                </button>
            ))
        }
    </div>

    <p class="feedback" aria-live="polite"></p>
    <button class="try-again" type="button" hidden> Try again </button>
</section>
<script>
    const quizzes = document.querySelectorAll<HTMLElement>(".quiz-question");

    quizzes.forEach((quiz) => {
        const buttons = quiz.querySelectorAll<HTMLButtonElement>(
            "button[data-answer-id]",
        );

        const answers = Array.from(buttons);

        if (quiz.dataset.shuffleAnswers === "true") {
            answers.sort(() => Math.random() - 0.5);

            answers.forEach((answer) => {
                answer.parentElement?.appendChild(answer);
            });
        }

        const feedback = quiz.querySelector<HTMLElement>(".feedback");

        const tryAgain = quiz.querySelector<HTMLButtonElement>(".try-again");

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                if (!feedback) return;

                const isCorrect = button.dataset.correct === "true";
                if (!isCorrect && tryAgain) {
                    tryAgain.hidden = false;
                }

                feedback.textContent =
                    button.dataset.feedback ??
                    (isCorrect ? "Correct." : "Not quite.");

                buttons.forEach((quizButton) => {
                    quizButton.disabled = true;

                    tryAgain?.addEventListener("click", () => {
                        buttons.forEach((quizButton) => {
                            quizButton.disabled = false;
                        });

                        if (feedback) {
                            feedback.textContent = "";
                        }

                        tryAgain.hidden = true;
                    });
                });
            });
        });
    });
</script>
