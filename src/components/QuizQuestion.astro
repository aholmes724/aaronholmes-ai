---
import type { Question } from "../data/questions";

interface Props {
    question: Question;
}

const { question } = Astro.props;
---

<section
    class="quiz-question"
    data-shuffle-answers={question.shuffleAnswers ?? true}
>
    <h2>{question.prompt}</h2>

    <div class="answers">
        {
            question.answers.map((answer) => (
                <label class="answer-option">
                    <input
                        type="radio"
                        name={`question-${question.id}`}
                        value={answer.id}
                        data-answer-id={answer.id}
                        data-correct={answer.correct}
                        data-feedback={answer.feedback}
                    />
                    <span>{answer.text}</span>
                </label>
            ))
        }
    </div>

    <p class="feedback" aria-live="polite"></p>
    <button class="try-again" type="button" hidden> Try again </button>
</section>
<script>
    const quizzes = document.querySelectorAll<HTMLElement>(".quiz-question");

    quizzes.forEach((quiz) => {
        const answers = quiz.querySelectorAll<HTMLInputElement>(
            "input[data-answer-id]",
        );

        const answerList = Array.from(answers);

        if (quiz.dataset.shuffleAnswers === "true") {
            answerList.sort(() => Math.random() - 0.5);

            answerList.forEach((answer) => {
                const answerOption = answer.closest(".answer-option");
                answerOption?.parentElement?.appendChild(answerOption);
            });
        }

        const feedback = quiz.querySelector<HTMLElement>(".feedback");

        const tryAgain = quiz.querySelector<HTMLButtonElement>(".try-again");

        answers.forEach((answer) => {
            answer.addEventListener("change", () => {
                if (!feedback) return;

                const isCorrect = answer.dataset.correct === "true";

                const answerOption =
                    answer.closest<HTMLElement>(".answer-option");

                if (answerOption) {
                    answerOption.dataset.result = isCorrect
                        ? "correct"
                        : "incorrect";
                }

                if (!isCorrect && tryAgain) {
                    tryAgain.hidden = false;
                }

                feedback.textContent =
                    answer.dataset.feedback ??
                    (isCorrect ? "Correct." : "Not quite.");

                answers.forEach((quizAnswer) => {
                    quizAnswer.disabled = true;
                });
            });
        });

        tryAgain?.addEventListener("click", () => {
            answers.forEach((quizAnswer) => {
                quizAnswer.disabled = false;
                quizAnswer.checked = false;

                const answerOption =
                    quizAnswer.closest<HTMLElement>(".answer-option");

                if (answerOption) {
                    delete answerOption.dataset.result;
                }
            });

            if (feedback) {
                feedback.textContent = "";
            }

            tryAgain.hidden = true;
        });
    });
</script>
